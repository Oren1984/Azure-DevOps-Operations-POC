# Copy to .env and adjust as needed. All defaults below are safe for fully
# local/offline operation - no Azure subscription or credentials required.

APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO

# SQLite file path (relative to the container/working directory), or
# ":memory:" for an ephemeral database that resets on restart.
APP_DATABASE_PATH=./data/app.db

# --- Rule engine thresholds ---
APP_RESTART_COUNT_THRESHOLD=3
APP_ERROR_RATE_THRESHOLD=0.05
APP_LATENCY_THRESHOLD_MS=1000
APP_NODE_READY_RATIO_THRESHOLD=0.7

# --- Optional AI incident assistant ---
# "deterministic" (default, fully offline) or "azure_openai" (illustrative
# only; requires the three values below and is never required to run the
# project). See app/integrations/ai_assistant.py.
APP_AI_PROVIDER=deterministic
# APP_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# APP_AZURE_OPENAI_API_KEY=
# APP_AZURE_OPENAI_DEPLOYMENT=<deployment-name>
